{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "description": "Every build tree lives under builds/, which is disposable and ignored by git.",
            "binaryDir": "${sourceDir}/builds/${presetName}",
            "cacheVariables": {
                "BRUTAL_MLP_BUILD_TESTS": "ON",
                "BRUTAL_MLP_BUILD_EXAMPLES": "ON"
            }
        },
        {
            "name": "release",
            "inherits": "base",
            "displayName": "Release (float, tests + benchmarks)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BRUTAL_MLP_BUILD_BENCHMARKS": "ON"
            }
        },
        {
            "name": "debug",
            "inherits": "base",
            "displayName": "Debug (float, tests)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "double",
            "inherits": "base",
            "displayName": "Release (double precision, tests)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BRUTAL_MLP_USE_DOUBLE": "ON"
            }
        },
        {
            "name": "ispc",
            "inherits": "base",
            "displayName": "Release (float, ISPC backend required, tests + benchmarks)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BRUTAL_MLP_BUILD_BENCHMARKS": "ON",
                "BRUTAL_MLP_REQUIRE_ISPC": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "release",
            "configurePreset": "release",
            "configuration": "Release"
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "configuration": "Debug"
        },
        {
            "name": "double",
            "configurePreset": "double",
            "configuration": "Release"
        },
        {
            "name": "ispc",
            "configurePreset": "ispc",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "release",
            "configurePreset": "release",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "double",
            "configurePreset": "double",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "ispc",
            "configurePreset": "ispc",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
